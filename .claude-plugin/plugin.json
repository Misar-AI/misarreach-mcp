{
  "name": "misarreach",
  "version": "2.0.0",
  "description": "Find leads, enrich and score them, run multi-channel outreach, and manage the sales pipeline — from any AI assistant.",
  "author": {
    "name": "Misar AI",
    "email": "support@misar.io",
    "url": "https://misar.io"
  },
  "homepage": "https://www.misarreach.com",
  "repository": "https://github.com/mrgulshanyadav/misarreach-mcp",
  "license": "MIT",
  "keywords": [
    "sales",
    "outreach",
    "lead-generation",
    "crm",
    "automation",
    "analytics"
  ],
  "mcpServers": {
    "misarreach": {
      "command": "npx",
      "args": [
        "-y",
        "@misarreach/mcp@latest"
      ],
      "env": {
        "MISARREACH_API_KEY": "${MISARREACH_API_KEY}"
      }
    }
  }
}
